# Environment variables (contains DB credentials - never commit this)
.env

# Python
venv/
__pycache__/
*.pyc
*.pyo

# Data files (generated by the pipeline - don't need to be in git)
data/raw/*.json
data/processed/*.csv

# Keep the folder structure even though contents are ignored
!data/raw/.gitkeep
!data/processed/.gitkeep

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db